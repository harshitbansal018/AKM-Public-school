# The browser calls the API on the same origin, so this is a relative path.
# Leave it as /api/v1 — it then works on localhost and on the real domain
# without being rebuilt.
NEXT_PUBLIC_API_URL=/api/v1

# Canonical site URL. Used for the sitemap, Open Graph tags, and to allow this
# host in next/image — uploaded images 400 if it is wrong.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match REVALIDATE_SECRET in apps/api/.env. Server-side only —
# deliberately NOT prefixed NEXT_PUBLIC_, so it never reaches the browser.
REVALIDATE_SECRET=change_me_to_a_long_random_string
