# Express API base URL. Leave blank to run the site on bundled fallback content.
NEXT_PUBLIC_API_URL=

# Canonical site URL — used for sitemap, robots and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match REVALIDATE_SECRET in apps/api/.env. Server-side only —
# deliberately NOT prefixed NEXT_PUBLIC_, so it never reaches the browser.
REVALIDATE_SECRET=change_me_to_a_long_random_string
