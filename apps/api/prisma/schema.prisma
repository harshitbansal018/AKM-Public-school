// AKM Public Sr. Sec. School — database schema
// Every value currently hardcoded in the old static site lives in one of these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  ADMITTED
  CLOSED
}

enum MediumType {
  ENGLISH
  HINDI
  BOTH
}

/// Admin panel accounts.
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notices Notice[]
}

/// Key/value site configuration: phone, email, address, timings, stat counters, SEO.
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("general") // contact | stats | social | seo | general
  label     String?
  updatedAt DateTime @updatedAt

  @@index([group])
}

/// The scrolling red ticker below the topbar.
model Announcement {
  id        Int       @id @default(autoincrement())
  text      String    @db.Text
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([isActive, sortOrder])
}

/// News & notices board.
model Notice {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  body        String?   @db.LongText
  noticeDate  DateTime
  category    String    @default("general") // exam | event | result | admission
  isPublished Boolean   @default(true)
  isPinned    Boolean   @default(false)
  viewCount   Int       @default(0)
  authorId    Int?
  downloadId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  download Download? @relation(fields: [downloadId], references: [id], onDelete: SetNull)

  @@index([isPublished, noticeDate])
  @@index([category])
}

/// Admission / contact form submissions.
model Enquiry {
  id          Int           @id @default(autoincrement())
  parentName  String
  phone       String
  email       String?
  studentName String?
  classGroup  String?
  medium      MediumType?
  // Optional on the form, and nullable here so the enquiries taken before this
  // field existed still load.
  address     String?       @db.Text
  message     String?       @db.Text
  status      EnquiryStatus @default(NEW)
  adminNote   String?       @db.Text
  source      String        @default("website")
  ipAddress   String?
  userAgent   String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

model GalleryAlbum {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String?   @db.Text
  coverImage  String?
  eventDate   DateTime?
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images GalleryImage[]

  @@index([isPublished, sortOrder])
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  albumId   Int
  imagePath String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, sortOrder])
}

/// Board toppers, sports and cultural wins.
model Achievement {
  id          Int      @id @default(autoincrement())
  studentName String
  classLabel  String?
  score       String?
  description String?  @db.Text
  medal       String   @default("medal-gold") // a LineIcon name: medal-gold | medal-silver | medal-bronze | trophy
  year        Int?
  type        String   @default("academic") // academic | sports | cultural
  photo       String?
  isFeatured  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isFeatured, year])
}

/// Principal and teaching staff. A faculty row is also the teacher-portal
/// account: `accountEmail` + `passwordHash` sign in, and `teacherAccess` gates
/// the portal. Admin-panel staff are separate (`User`).
model Faculty {
  id            Int      @id @default(autoincrement())
  name          String
  designation   String
  qualification String?
  subject       String?
  message       String?  @db.Text
  photo         String?
  isPrincipal   Boolean  @default(false)
  /// Managing Director — supplies the second message beside the principal's.
  isDirector    Boolean  @default(false)
  accountEmail  String?  @unique
  passwordHash  String?
  teacherAccess Boolean  @default(false)
  /// JSON array of class/section labels this teacher may manage, e.g. ["Class 5"].
  assignedClasses String? @db.LongText
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salaries FacultySalary[]

  @@index([isPublished, sortOrder])
}

/// Pre-Primary … Senior Secondary cards.
model AcademicStage {
  id          Int     @id @default(autoincrement())
  title       String
  classRange  String
  description String  @db.Text
  icon        String  @default("book") // a LineIcon name, chosen in the admin panel
  accentColor String  @default("#E3A81C")
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  @@index([isPublished, sortOrder])
}

/// Class 11–12 streams.
model Stream {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String  @unique
  description String  @db.Text
  subjects    Json
  icon        String  @default("book")
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Facility {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  icon        String  @default("school")
  image       String?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  @@index([isPublished, sortOrder])
}

/// Date sheets, syllabi, forms, results.
model Download {
  id            Int      @id @default(autoincrement())
  title         String
  filePath      String
  fileSize      Int?
  mimeType      String?
  category      String   @default("general")
  isPublic      Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  notices Notice[]

  @@index([isPublic, category])
}

/// Generic uploaded media registry.
model MediaFile {
  id           Int      @id @default(autoincrement())
  originalName String
  path         String
  mimeType     String
  size         Int
  folder       String   @default("misc")
  createdAt    DateTime @default(now())
}

/// Parent-portal accounts. One login per family: a parent is linked to one or
/// more students and can only ever read those students' records.
model Parent {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  children Student[]
}

model Student {
  id           Int      @id @default(autoincrement())
  name         String
  classGroup   String
  rollNumber   String?
  guardianName String
  phone        String?
  address      String?  @db.Text
  parentId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent  Parent?     @relation(fields: [parentId], references: [id], onDelete: SetNull)
  results Result[]
  fees    FeeRecord[]

  @@index([classGroup, name])
  @@index([parentId])
}

model Homework {
  id          Int       @id @default(autoincrement())
  title       String
  classGroup  String
  subject     String
  dueDate     DateTime?
  description String?   @db.Text
  isPublished Boolean   @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classGroup, dueDate])
}

/// `studentId` is the link the parent portal relies on; `studentName` and
/// `classGroup` are copied from the student on save so the row still reads
/// correctly if the student is later removed from the register.
model Result {
  id          Int       @id @default(autoincrement())
  studentId   Int?
  studentName String
  classGroup  String
  exam        String
  score       String
  resultDate  DateTime?
  remarks     String?   @db.Text
  isPublished Boolean   @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([classGroup, exam])
  @@index([studentId])
}

model FeeRecord {
  id          Int       @id @default(autoincrement())
  studentId   Int?
  studentName String
  classGroup  String
  amount      Decimal   @db.Decimal(10, 2)
  /// What has actually been received against `amount`; the difference is outstanding.
  paidAmount  Decimal   @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  status      String    @default("DUE") // DUE | PARTIAL | PAID
  notes       String?   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([classGroup, status])
  @@index([studentId])
}

/// One row per teacher per salary month. `facultyId` is the real link (the
/// teacher portal and per-teacher history follow it); `facultyName` is copied
/// from the record on save so the row still reads if the person leaves.
model FacultySalary {
  id          Int       @id @default(autoincrement())
  facultyId   Int?
  facultyName String
  month       String
  amount      Decimal   @db.Decimal(10, 2)
  paymentDate DateTime?
  status      String    @default("DUE") // DUE | PAID
  notes       String?   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@index([facultyName, month])
  @@index([facultyId])
}

/// Teacher/staff job applications from the website's Careers page.
model JobApplication {
  id            Int      @id @default(autoincrement())
  /// Shown to the applicant on submission, e.g. AKM-2026-0042.
  reference     String?  @unique
  name          String
  position      String
  subject       String?
  qualification String?
  experience    String?
  currentSchool String?
  email         String?
  phone         String?
  address       String?  @db.Text
  /// Relative to the uploads dir; served only through the admin API.
  resumePath    String?
  resumeName    String?
  status        String   @default("NEW") // NEW | UNDER_REVIEW | SHORTLISTED | INTERVIEW | SELECTED | REJECTED
  /// What the applicant wrote on the form.
  notes         String?  @db.Text
  /// The office's own remarks (interview feedback etc.) — never shown to the applicant.
  adminNote     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

/// School policies, edited by the office and published without a code change.
/// `category` is the tab on the website's Policies page (the office defines the
/// tabs under Website content), so any number of tabs can exist.
model Policy {
  id            Int       @id @default(autoincrement())
  title         String
  category      String    @default("General")
  effectiveDate DateTime?
  status        String    @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  /// Plain text with light markers: blank line = paragraph, "- " = bullet, "## " = sub-heading.
  content       String    @db.LongText
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([category, status])
}
