NODE_ENV=development

# One process serves both the API and the website, so this is the only port.
PORT=3000
API_PREFIX=/api/v1

# MySQL / MariaDB. Create the database first:
#   CREATE DATABASE akm_school CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# XAMPP's default root user has no password: mysql://root@localhost:3306/akm_school
DATABASE_URL="mysql://root:password@localhost:3306/akm_school"

# Generate real ones before deploying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Only needed if something outside this app calls the API. Same-origin
# requests from the website itself do not use CORS at all.
CORS_ORIGINS=http://localhost:3000

UPLOAD_DIR=uploads
MAX_IMAGE_MB=2
MAX_DOCUMENT_MB=20

# Prefix for uploaded image URLs. Must be the public address of the site —
# a wrong value here breaks every uploaded image with no visible error.
PUBLIC_BASE_URL=http://localhost:3000

# Leave SMTP_HOST blank to log enquiry emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AKM School <no-reply@akmpublicschool.in>"
ENQUIRY_NOTIFY_TO=info@akmpublicschool.in

# The account created by the seed. Change the password after first sign-in.
SEED_ADMIN_NAME="School Administrator"
SEED_ADMIN_EMAIL=admin@akmpublicschool.in
SEED_ADMIN_PASSWORD=Admin@12345

# After a content change the API tells Next.js to drop its cache. Same process,
# so this points at ourselves. REVALIDATE_SECRET must match apps/web/.env.local.
# REVALIDATE_URL is derived from PORT automatically — only set it if the
# website is served by a different process than this API.
# REVALIDATE_URL=
REVALIDATE_SECRET=change_me_to_a_long_random_string
