NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MySQL
DATABASE_URL="mysql://root:password@localhost:3306/akm_school"

# Auth
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
PUBLIC_BASE_URL=http://localhost:5000

# Mail (admission enquiry notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AKM School <no-reply@akmpublicschool.in>"
ENQUIRY_NOTIFY_TO=info@akmpublicschool.in

# Cache busting — the API pings the Next.js app after a content change.
# REVALIDATE_SECRET must match the value in apps/web/.env.local
# Comma-separated list is allowed — useful in dev, where Next hops ports.
REVALIDATE_URL=http://localhost:3000/api/revalidate,http://localhost:3001/api/revalidate
REVALIDATE_SECRET=change_me_to_a_long_random_string
